# =========================
# Core services
# =========================
DISCORD_TOKEN=define_o_token_do_bot_discord
TELEGRAM_BOT_TOKEN=define_o_token_do_bot_telegram
TELEGRAM_POLL_TIMEOUT_SECONDS=30
ORCHESTRATOR_URL=http://orchestrator:8000
ORCHESTRATOR_PORT=8000
ORCHESTRATOR_HISTORY_LIMIT=12
ORCHESTRATOR_TIMING_LOGS=true

POSTGRES_DB=agentpulse
POSTGRES_USER=agentpulse
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_URL=

LLM_SERVICE_URL=http://llm-service:8001
LLM_SERVICE_PORT=8001
NORMALIZER_SERVICE_URL=http://normalizer-service:8002
NORMALIZER_SERVICE_PORT=8002
CALENDAR_SERVICE_URL=http://calendar-service:8003
CALENDAR_SERVICE_PORT=8003
EXTRACTOR_SERVICE_URL=http://extractor-service:8004
EXTRACTOR_SERVICE_PORT=8004
VALIDATOR_SERVICE_URL=http://validator-service:8005
VALIDATOR_SERVICE_PORT=8005

APP_TIMEZONE=Europe/Lisbon

# =========================
# Dashboard and auth
# =========================
DASHBOARD_PORT=8088
DASHBOARD_BASE_URL=http://localhost:8088
DASHBOARD_SERVICE_URL=http://dashboard-service:8088
DASHBOARD_INTERNAL_API_TOKEN=
DASHBOARD_CONFIG_CACHE_MS=3000
DISCORD_GATEWAY_URL=http://gateway:8010
DISCORD_GATEWAY_INTERNAL_PORT=8010
TELEGRAM_GATEWAY_URL=http://telegram-gateway:8011
TELEGRAM_GATEWAY_INTERNAL_PORT=8011
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_CONTACT_EMAIL=miguelcrespovenancio@hotmail.com
DEFAULT_ADMIN_EMAIL=admin@movic.local
DEFAULT_ADMIN_PASSWORD=

# =========================
# Config database and encryption
# =========================
CONFIG_POSTGRES_DB=agentpulse_config
CONFIG_POSTGRES_USER=agentpulse_config
CONFIG_POSTGRES_PASSWORD=
CONFIG_POSTGRES_URL=
CONFIG_ENCRYPTION_KEY=

# =========================
# Apple connector
# Nota: as credenciais Apple do utilizador
# são introduzidas depois na dashboard.
# =========================
APPLE_CONNECTOR_URL=http://apple-connector:8006
APPLE_CONNECTOR_PORT=8006
APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_SYNC_INTERVAL_MS=60000

# =========================
# Google connector
# Obrigatório apenas para usar a ligação Google.
# =========================
GOOGLE_CONNECTOR_URL=http://google-connector:8007
GOOGLE_CONNECTOR_PORT=8007
GOOGLE_SYNC_INTERVAL_MS=60000
GOOGLE_CLIENT_ID=define_o_client_id_google
GOOGLE_CLIENT_SECRET=define_o_client_secret_google
GOOGLE_REDIRECT_URI=http://localhost:8088/dashboard/google/callback

# =========================
# Notion connector
# Obrigatório apenas para usar a ligação Notion.
# =========================
NOTION_CONNECTOR_URL=http://notion-connector:8008
NOTION_CONNECTOR_PORT=8008
NOTION_SYNC_INTERVAL_MS=60000
NOTION_CLIENT_ID=define_o_client_id_notion
NOTION_CLIENT_SECRET=define_o_client_secret_notion
NOTION_REDIRECT_URI=http://localhost:8088/dashboard/notion/callback
NOTION_API_VERSION=2022-06-28
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# =========================
# Ollama / hybrid AI models
# =========================
# Runtime local usado pelo normalizer e validator.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_AUTO_PULL=true
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMING_LOGS=true
OLLAMA_API_KEY=

# LLM principal em Ollama Cloud.
LLM_OLLAMA_BASE_URL=https://ollama.com
LLM_OLLAMA_MODEL=gpt-oss:120b-cloud
LLM_OLLAMA_API_KEY=define_a_api_key_ollama_cloud
LLM_OLLAMA_AUTO_PULL=false

# Extractor em Ollama Cloud.
EXTRACTOR_OLLAMA_BASE_URL=https://ollama.com
EXTRACTOR_OLLAMA_MODEL=gpt-oss:120b-cloud
EXTRACTOR_OLLAMA_API_KEY=define_a_api_key_ollama_cloud
EXTRACTOR_OLLAMA_AUTO_PULL=false

# Normalizer local na VM.
NORMALIZER_OLLAMA_BASE_URL=http://ollama:11434
NORMALIZER_OLLAMA_MODEL=qwen2.5:3b
NORMALIZER_OLLAMA_API_KEY=
NORMALIZER_MODEL=qwen2.5:3b
NORMALIZER_AUTO_PULL=true

# Validator local na VM.
VALIDATOR_OLLAMA_BASE_URL=http://ollama:11434
VALIDATOR_OLLAMA_MODEL=qwen2.5:3b
VALIDATOR_OLLAMA_API_KEY=
VALIDATOR_MODEL=qwen2.5:3b
VALIDATOR_AUTO_PULL=true
