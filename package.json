{
  "name": "ai-personal-calendar-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "discord",
    "telegram",
    "dashboard",
    "apple-connector",
    "google-connector",
    "notion-connector",
    "orchestrator",
    "llm-service",
    "normalizer-service",
    "calendar-service",
    "extractor-service",
    "validator-service"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace discord-gateway",
    "dev:telegram": "npm run dev --workspace telegram-gateway",
    "dev:dashboard": "npm run dev --workspace dashboard-service",
    "dev:apple": "npm run dev --workspace apple-connector",
    "dev:google": "npm run dev --workspace google-connector",
    "dev:notion": "npm run dev --workspace notion-connector",
    "dev:orchestrator": "npm run dev --workspace orchestrator",
    "dev:llm": "npm run dev --workspace llm-service",
    "dev:normalizer": "npm run dev --workspace normalizer-service",
    "dev:calendar": "npm run dev --workspace calendar-service",
    "dev:extractor": "npm run dev --workspace extractor-service",
    "dev:validator": "npm run dev --workspace validator-service",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "eval:run": "node scripts/run-evals.mjs",
    "start:gateway": "npm run start --workspace discord-gateway",
    "start:telegram": "npm run start --workspace telegram-gateway",
    "start:dashboard": "npm run start --workspace dashboard-service",
    "start:apple": "npm run start --workspace apple-connector",
    "start:google": "npm run start --workspace google-connector",
    "start:notion": "npm run start --workspace notion-connector",
    "start:orchestrator": "npm run start --workspace orchestrator",
    "start:llm": "npm run start --workspace llm-service",
    "start:normalizer": "npm run start --workspace normalizer-service",
    "start:calendar": "npm run start --workspace calendar-service",
    "start:extractor": "npm run start --workspace extractor-service",
    "start:validator": "npm run start --workspace validator-service"
  }
}
