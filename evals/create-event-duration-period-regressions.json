        {
          "content": "Marca me reuniao para amanha as 15h que dura uma 1h",
          "expect": {
            "command": "create_event",
            "isComplete": false,
            "shouldAskFollowUp": true,
            "replyIncludes": ["nota"],
            "replyExcludes": ["a que horas", "ate que horas"],
            "missingFieldsIncludes": ["description"],
            "missingFieldsExcludes": ["startTime", "endTime", "__descriptionSkipped"],
            "extractedDataSubset": {
              "title": "Reuniao",
              "date": "{{today+1d}}",
              "startTime": "15:00",
              "endTime": "16:00"
            }
          }
