{
  "suite": "delete_event_regressions",
  "cases": [
    {
      "id": "delete_single_event_requires_confirmation",
      "turns": [
        {
          "content": "Apaga a reuniao na sexta",
          "options": {
            "mockCalendarSearchResults": [
              {
                "pageId": "evt-1",
                "title": "Reuniao",
                "date": "2026-04-03",
                "startTime": "10:00",
                "endTime": "11:30",
                "description": "Projeto Fire"
              }
            ]
          },
          "expect": {
            "command": "delete_event",
            "isComplete": false,
            "shouldAskFollowUp": true,
            "missingFieldsIncludes": [
              "deleteConfirmation"
            ],
            "replyIncludes": [
              "Queres mesmo apagar",
              "Reuniao",
              "Projeto Fire"
            ]
          }
        },
        {
          "content": "sim",
          "expect": {
            "command": "delete_event",
            "isComplete": true,
            "shouldAskFollowUp": false,
            "needsCalendarAction": true
          }
        }
      ]
    },
    {
      "id": "delete_single_event_can_be_cancelled",
