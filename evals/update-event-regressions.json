                "endTime": "11:00"
              }
            ]
          },
          "expect": {
            "command": "update_event",
            "isComplete": false,
            "shouldAskFollowUp": true,
            "missingFieldsIncludes": [
              "updateTime"
            ],
            "replyIncludes": [
              "novas horas",
              "consulta"
