      "turns": [
        {
          "content": "O que tenho marcado para hoje",
          "options": {
            "mockCalendarSearchResults": [
              {
                "pageId": "list-today-1",
                "title": "Reuniao",
                "date": "{{today}}",
                "startTime": "10:00",
                "endTime": "11:30",
                "description": "Projeto Fire"
              },
              {
                "pageId": "list-today-2",
                "title": "Almoco",
